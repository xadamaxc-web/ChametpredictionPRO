<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A1E"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="📊 Analytics" android:textColor="#FCA311"
            android:textSize="22sp" android:textStyle="bold" android:paddingBottom="12dp" />
        <TextView android:id="@+id/tvAnalytics"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="13sp"
            android:fontFamily="monospace" android:lineSpacingExtra="2dp"
            android:text="Loading…" />
        <Button android:id="@+id/btnExportAnalytics"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="📤 Export CSV" android:backgroundTint="#4A4A6E"
            android:layout_marginTop="16dp" />
        <Button android:id="@+id/btnRefreshAnalytics"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="🔄 Refresh" android:backgroundTint="#4A4A6E"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
